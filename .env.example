# dit-server configuration. Copy to .env and fill in.
#
# Every value here can also come from a YAML file (see config.example.yaml);
# environment variables win over the file.

# REQUIRED. The shared secret the CLI sends as `Authorization: Bearer <token>`.
# The server refuses to start without it. Generate one with:
#   openssl rand -base64 32
DIT_API_TOKEN=

# REQUIRED unless DIT_MASTER_KEY_FILE points at a readable key. base64 of 32
# random bytes, used to seal registry credentials and channel secrets at rest.
# Generate one with:
#   openssl rand -base64 32
# If unset, a key is generated into $DIT_DATA_DIR/master.key with 0600 and a
# loud warning is logged. Back that file up: losing it makes every stored
# secret unrecoverable.
DIT_MASTER_KEY=

# Where the SQLite database and the generated master key live.
DIT_DATA_DIR=./data

# Address to listen on.
DIT_LISTEN=:8080

# How often every watch is checked, and how many are checked at once.
DIT_CHECK_INTERVAL=15m
DIT_CHECK_CONCURRENCY=4
DIT_CHECK_TIMEOUT=30s

# Notification delivery: attempts per channel and the base backoff between them.
DIT_NOTIFY_ATTEMPTS=3
DIT_NOTIFY_BACKOFF=5s

# debug, info, warn or error.
DIT_LOG_LEVEL=info

# Channels that watches with no explicit subscription notify. When empty, the
# channels flagged is_default are used instead.
DIT_DEFAULT_CHANNELS=

# Host port for docker-compose.
DIT_PORT=8080

# ---------- CLI (not read by the server) ----------

# Where `dit` finds its config file. Defaults to ~/.config/dit/config.yaml.
# DIT_CONFIG=~/.config/dit/config.yaml
# DIT_SERVER_URL=http://localhost:8080
# DIT_API_TOKEN=
# DIT_OUTPUT=table
